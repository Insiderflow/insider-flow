# Copy to .env.local and adjust.
# Vite loads these for the dev server and client (VITE_ prefix = exposed to import.meta.env).

# web = cookie session via /api/auth/*  |  mobile = bearer + refresh via /api/mobile/auth/*
VITE_AUTH_TRANSPORT=web

# Leave empty to use same origin + Vite /api proxy (see vite.config.js).
# Set to full API origin only for direct calls (e.g. https://your-api.onrender.com) — CORS must allow the UI origin.
VITE_API_BASE_URL=

# Where Vite proxies /api in dev. Use the port your Next app prints (e.g. 3005 if 3000 is taken).
VITE_BACKEND_ORIGIN=http://localhost:3000

# Optional: Sentry browser DSN (npm i @sentry/react and wire in main.jsx if you add it).
# VITE_SENTRY_DSN=
