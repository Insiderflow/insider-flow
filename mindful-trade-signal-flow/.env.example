# Copy to .env.local and adjust.
# Vite loads these for the dev server and client (VITE_ prefix = exposed to import.meta.env).

# web = cookie session via /api/auth/*  |  mobile = bearer + refresh via /api/mobile/auth/*
VITE_AUTH_TRANSPORT=web

# Leave empty to use same origin + Vite /api proxy (see vite.config.js).
# Set to full API origin only for direct calls (e.g. https://your-api.onrender.com) — CORS must allow the UI origin.
VITE_API_BASE_URL=

# Native OAuth (when VITE_AUTH_TRANSPORT=mobile): web redirect uses NextAuth at VITE_API_BASE_URL + /api/auth/signin/*
# Google: OAuth Web Client ID from Google Cloud (same project as server credentials).
# VITE_GOOGLE_WEB_CLIENT_ID=

# Facebook: Meta App ID — same numeric ID as FACEBOOK_CLIENT_ID on the API (no secret in the client).
# VITE_FACEBOOK_APP_ID=

# Sign in with Apple (native): Services ID / client ID from Apple Developer for your app’s bundle ID flow.
# VITE_APPLE_IOS_CLIENT_ID=
# Optional override; default prod redirect matches insiderflow.asia unless you host elsewhere.
# VITE_APPLE_REDIRECT_URI=

# Where Vite proxies /api in dev. Use the port your Next app prints (e.g. 3005 if 3000 is taken).
VITE_BACKEND_ORIGIN=http://localhost:3000

# Optional: Sentry browser DSN (npm i @sentry/react and wire in main.jsx if you add it).
# VITE_SENTRY_DSN=

# --- App Store / Play release ---
# Production bundle reads `.env.production` (`vite build`). Template committed:
#   VITE_AUTH_TRANSPORT=mobile
#   VITE_API_BASE_URL=https://www.insiderflow.asia
# Run `npm run mobile:release-check` before archiving.
