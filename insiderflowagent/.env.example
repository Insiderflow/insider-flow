# ============================================================
# Insider Flow AI Agent — 環境設定範例
# 複製成 .env 後按需要修改：cp .env.example .env
# ============================================================

# --- 部署模式 ---
# cpu = 純 CPU（入門，適合試用 / 小團隊）
# gpu = 啟用 NVIDIA GPU 加速 Ollama（需已安裝 nvidia-container-toolkit）
COMPOSE_PROFILES=cpu

# --- 對外端口（公司內網 IP + 端口）---
OLLAMA_PORT=11434
OPENWEBUI_PORT=3000
N8N_PORT=5678
CHROMA_PORT=8000
API_PORT=8080

# --- Open WebUI ---
# 首次登入會要求建立管理員帳號
WEBUI_SECRET_KEY=請改成隨機長字串_至少32字元
WEBUI_NAME=公司 AI 助手
# 允許的來源（CORS），留空 = 同域
WEBUI_ALLOWED_ORIGINS=

# --- Ollama ---
# 預設拉取的模型（可改為 qwen2.5:7b、llama3.2 等）
OLLAMA_DEFAULT_MODEL=llama3.2:3b
# GPU 模式時可指定可見 GPU
# NVIDIA_VISIBLE_DEVICES=all

# --- n8n（工作流 / Human-in-the-loop）---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=請改成強密碼
N8N_HOST=localhost
N8N_PROTOCOL=http
# Webhook 基礎 URL（若用反向代理請改）
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Chroma（向量資料庫 / 知識庫）---
CHROMA_SERVER_AUTH_CREDENTIALS=
CHROMA_SERVER_AUTH_PROVIDER=

# --- FastAPI 輔助服務（可選，處理文件上傳 / 審計）---
API_SECRET_KEY=請改成隨機長字串
ENABLE_AUDIT_LOG=true

# --- 資料持久化路徑（相對於 docker-compose.yml）---
DATA_DIR=./data

# --- 時區 ---
TZ=Asia/Hong_Kong
