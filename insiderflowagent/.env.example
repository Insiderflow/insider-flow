# ============================================================
# 私域 AI Agent — 環境設定範例
# 複製成 .env 後按需要修改：cp .env.example .env
# ============================================================

# --- 部署模式 ---
# cpu = 純 CPU（入門，適合試用 / 小團隊）
# gpu = 啟用 NVIDIA GPU 加速 Ollama（需已安裝 nvidia-container-toolkit）
COMPOSE_PROFILES=cpu

# --- 對外端口（公司內網 IP + 端口）---
OLLAMA_PORT=11434
OPENWEBUI_PORT=3000
N8N_PORT=5678
CHROMA_PORT=8000
API_PORT=8080

# --- Open WebUI ---
# 首次登入會要求建立管理員帳號（Open WebUI 預設行為）
WEBUI_SECRET_KEY=請改成隨機長字串_至少32字元
WEBUI_NAME=公司 AI 助手
WEBUI_ALLOWED_ORIGINS=
# Open WebUI 預設顯示嘅模型（需先由 Ollama pull）
DEFAULT_MODELS=qwen2.5:3b

# --- Ollama ---
# install.sh / install.bat 會自動 pull 此模型
OLLAMA_DEFAULT_MODEL=qwen2.5:3b
# GPU 模式時可指定可見 GPU
# NVIDIA_VISIBLE_DEVICES=all

# --- n8n（工作流 / Human-in-the-loop）---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=請改成強密碼
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

# --- FastAPI 輔助服務（審計日誌）---
API_SECRET_KEY=請改成隨機長字串
ENABLE_AUDIT_LOG=true

# --- 時區 ---
TZ=Asia/Hong_Kong
