# ============================================================
# 私域 AI — Free Plan 環境設定
# 複製成 .env：cp .env.example .env
# ============================================================

# --- 部署模式 ---
# cpu = Free Plan 入門（Ollama + Open WebUI + Chroma）
# gpu = 同上 + GPU 加速 Ollama
# pro = Professional 加購（n8n + Audit API），需專人協助，唔會自動啟用
COMPOSE_PROFILES=cpu

# --- 對外端口 ---
OLLAMA_PORT=11434
OPENWEBUI_PORT=3000
CHROMA_PORT=8000

# --- Open WebUI ---
# 首次登入會要求建立管理員帳號
WEBUI_SECRET_KEY=請改成隨機長字串_至少32字元
WEBUI_NAME=公司私有 AI 助手
WEBUI_ALLOWED_ORIGINS=
DEFAULT_MODELS=qwen2.5:3b

# --- Ollama ---
OLLAMA_DEFAULT_MODEL=qwen2.5:3b

# --- Professional Plan（optional，預設唔啟用）---
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=請改成強密碼
N8N_WEBHOOK_URL=http://localhost:5678/
API_PORT=8080
API_SECRET_KEY=請改成隨機長字串

# --- 時區 ---
TZ=Asia/Hong_Kong
