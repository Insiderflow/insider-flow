generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IndustrySubsector {
  slug          String   @id
  parent_sector String
  name_en       String
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())
  Issuer        Issuer[]

  @@index([parent_sector])
  @@map("IndustrySubsector")
}

model Issuer {
  id              String             @id
  ticker          String?
  name            String
  sector          String?
  sub_sector_slug String?
  country         String?
  created_at      DateTime           @default(now())
  Trade           Trade[]
  IndustrySubsector IndustrySubsector? @relation(fields: [sub_sector_slug], references: [slug], onDelete: SetNull)

  @@index([ticker])
  @@index([name])
  @@index([sector])
  @@index([sub_sector_slug])
  @@map("Issuer")
}

model Politician {
  id            String          @id
  name          String
  party         String?
  chamber       String?
  state         String?
  committees             String?
  /** GovTrack committee codes + names: [{ code, name?, parentCode? }] */
  committee_assignments  Json?
  created_at             DateTime        @default(now())
  Trade         Trade[]
  UserWatchlist UserWatchlist[]
  referencePortfolios UserReferencePortfolio[]

  @@index([name])
  @@index([party])
  @@index([chamber])
  @@map("Politician")
}

model LegacySession {
  id         String   @id
  user_id    String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([user_id])
  @@map("Session")
}

model Trade {
  id               String     @id
  politician_id    String
  issuer_id        String
  published_at     DateTime?
  traded_at        DateTime
  filed_after_days Int?
  owner            String?
  type             String
  size_min         Decimal?
  size_max         Decimal?
  price            Decimal?
  source_url       String?
  raw              Json?
  created_at       DateTime   @default(now())
  Issuer           Issuer     @relation(fields: [issuer_id], references: [id])
  Politician       Politician @relation(fields: [politician_id], references: [id])

  @@index([politician_id])
  @@index([issuer_id])
  @@index([traded_at(sort: Desc)])
  @@index([published_at(sort: Desc)])
  @@index([type, traded_at(sort: Desc)])
  @@index([issuer_id, traded_at(sort: Desc)])
  @@index([politician_id, traded_at(sort: Desc)])
  @@map("Trade")
}

model User {
  id                       String          @id @default(cuid())
  email                    String          @unique
  name                     String?
  image                    String?
  emailVerified            DateTime?
  password_hash            String?
  email_verified           Boolean         @default(false)
  email_verification_token String?
  password_reset_token     String?
  password_reset_expires   DateTime?
  created_at               DateTime        @default(now())
  updated_at               DateTime        @updatedAt
  notification_settings    Json?
  membership_tier          MembershipTier  @default(FREE)
  membership_expires_at    DateTime?
  subscription_status      String?
  billing_provider         String?
  subscription_entitlement_id String?
  subscription_last_synced_at DateTime?
  stripe_customer_id       String?
  stripe_subscription_id   String?
  alerts                   Alert[]
  subscription_audits      SubscriptionTransitionAudit[]
  LegacySession            LegacySession[]
  UserWatchlist            UserWatchlist[]
  referencePortfolios      UserReferencePortfolio[]
  accounts                 Account[]
  sessions                 Session[]
}

enum MembershipTier {
  FREE
  PAID
}

enum AlertType {
  notable_trade
  politician
  watchlist
  corporate
  seat_alignment
}

model Alert {
  id         String    @id @default(cuid())
  user_id    String
  type       AlertType @default(watchlist)
  title      String
  body       String
  ticker     String?
  timestamp  DateTime  @default(now())
  read       Boolean   @default(false)
  read_at    DateTime?
  source_key String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, source_key])
  @@index([user_id, read, timestamp(sort: Desc)])
}

model UserWatchlist {
  id            String   @id @default(cuid())
  user_id       String
  politician_id String?
  company_id    String?
  owner_id      String?
  ticker        String?
  watchlist_type String  // 'politician', 'company', 'owner', 'stock'
  created_at    DateTime @default(now())
  
  Politician    Politician? @relation(fields: [politician_id], references: [id], onDelete: Cascade)
  Company       OpenInsiderCompany? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  Owner         OpenInsiderOwner? @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  User          User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([watchlist_type])
  @@unique([user_id, politician_id, watchlist_type])
  @@unique([user_id, company_id, watchlist_type])
  @@unique([user_id, owner_id, watchlist_type])
  @@unique([user_id, ticker, watchlist_type])
}

// OpenInsider Data Models
model OpenInsiderCompany {
  id          String   @id @default(cuid())
  ticker      String   @unique
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  transactions OpenInsiderTransaction[]
  watchlists   UserWatchlist[]
  
  @@map("openinsider_companies")
}

model OpenInsiderOwner {
  id            String   @id @default(cuid())
  name          String   @unique
  title         String?
  isInstitution Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  transactions OpenInsiderTransaction[]
  watchlists   UserWatchlist[]
  
  @@map("openinsider_owners")
}

model OpenInsiderTransaction {
  id                String   @id @default(cuid())
  transactionDate   DateTime @map("transaction_date")
  tradeDate         DateTime @map("trade_date")
  transactionType   String   @map("transaction_type")
  lastPrice         Decimal? @map("last_price")
  quantity          String
  sharesHeld        String   @map("shares_held")
  owned             String
  value             String
  valueNumeric      Decimal? @map("value_numeric")
  
  companyId         String   @map("company_id")
  company           OpenInsiderCompany @relation(fields: [companyId], references: [id])
  
  ownerId           String   @map("owner_id")
  owner             OpenInsiderOwner @relation(fields: [ownerId], references: [id])
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  @@index([transactionDate(sort: Desc)])
  @@index([tradeDate(sort: Desc)])
  @@index([companyId])
  @@index([ownerId])
  @@index([transactionType])
  @@map("openinsider_transactions")
}

/** Quarterly-ish 13F-style holdings snapshots from Finnhub (not corporate Form 4). */
model InstitutionalHoldingSnapshot {
  id           String   @id
  symbol       String
  reportDate   DateTime @map("report_date")
  investorCik  String?  @map("investor_cik")
  investorName String   @map("investor_name")
  putCall      String?  @map("put_call")
  changeShares Decimal? @map("change_shares") @db.Decimal(30, 4)
  sharesHeld   Decimal? @map("shares_held") @db.Decimal(30, 4)
  valueUsd     Decimal? @map("value_usd") @db.Decimal(30, 4)
  pctPortfolio Decimal? @map("pct_portfolio") @db.Decimal(14, 8)
  dataSource   String   @default("finnhub") @map("data_source")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([symbol])
  @@index([reportDate(sort: Desc)])
  @@map("institutional_holding_snapshots")
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SubscriptionEvent {
  id           String   @id @default(cuid())
  provider     String
  event_key    String
  event_type   String
  status       String   @default("processing")
  retry_count  Int      @default(0)
  next_retry_at DateTime?
  payload      Json?
  processed_at DateTime?
  error        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([provider, event_key])
  @@index([provider, status, created_at(sort: Desc)])
  @@map("subscription_events")
}

model SubscriptionTransitionAudit {
  id                       String   @id @default(cuid())
  user_id                  String
  source                   String
  event_key                String?
  event_type               String?
  decision_reason          String
  applied                  Boolean
  previous_membership_tier String?
  previous_subscription_status String?
  previous_billing_provider String?
  previous_expires_at      DateTime?
  previous_entitlement_id  String?
  incoming_provider        String
  incoming_subscription_status String
  incoming_expires_at      DateTime?
  incoming_entitlement_id  String?
  resulting_membership_tier String?
  resulting_subscription_status String?
  resulting_billing_provider String?
  resulting_expires_at     DateTime?
  resulting_entitlement_id String?
  created_at               DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@index([source, created_at(sort: Desc)])
  @@map("subscription_transition_audits")
}

enum ReferencePortfolioTemplate {
  politician_mirror
  flagged_buys
}

model UserReferencePortfolio {
  id              String                     @id @default(cuid())
  user_id         String
  name            String
  template        ReferencePortfolioTemplate
  politician_id   String?
  period_days     Int                        @default(30)
  position_limit  Int                        @default(10)
  last_built_at   DateTime?
  created_at      DateTime                   @default(now())
  updated_at      DateTime                   @updatedAt
  User            User                       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Politician      Politician?                @relation(fields: [politician_id], references: [id], onDelete: SetNull)
  positions       UserReferencePortfolioPosition[]

  @@index([user_id])
  @@map("user_reference_portfolios")
}

model UserReferencePortfolioPosition {
  id              String   @id @default(cuid())
  portfolio_id    String
  ticker          String
  issuer_name     String?
  side            String
  weight_pct      Float
  source_trade_id String?
  disclosure_date DateTime?
  added_at        DateTime @default(now())
  portfolio       UserReferencePortfolio @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)

  @@index([portfolio_id])
  @@map("user_reference_portfolio_positions")
}

model OpsAlertNotification {
  id           String   @id @default(cuid())
  alert_key    String   @unique
  severity     String
  last_sent_at DateTime?
  send_count   Int      @default(0)
  last_payload Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([last_sent_at])
  @@map("ops_alert_notifications")
}

/** Latest batch from Python `insider_ml_analyzer` (Grok CSV / cron). */
model MlSignalSnapshot {
  id            String   @id @default(cuid())
  source_label  String?
  generated_at  DateTime
  payload       Json
  created_at    DateTime @default(now())

  @@index([generated_at(sort: Desc)])
  @@map("ml_signal_snapshots")
}

/** AI Agent professional plan questionnaire ( /ai-agent/questionnaire ). */
model AiAgentQuestionnaireSubmission {
  id           String   @id @default(cuid())
  company_name String
  contact_name String
  email        String
  phone        String?
  answers      Json
  notes        String?
  created_at   DateTime @default(now())

  @@index([created_at(sort: Desc)])
  @@index([email])
  @@map("ai_agent_questionnaire_submissions")
}
