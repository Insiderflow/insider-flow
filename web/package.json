{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next && prisma generate && NODE_OPTIONS='--max-old-space-size=460' next build",
    "start": "NODE_OPTIONS='--max-old-space-size=384' next start",
    "lint": "eslint src e2e",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "release:check": "node scripts/release-check.mjs",
    "release:check:dry": "node scripts/release-check.mjs --dry-run",
    "release:check:local": "node scripts/release-check.mjs --dry-run --skip-health",
    "release:check:ci": "node scripts/release-check.mjs --dry-run --skip-health --skip-prisma --skip-frontend-check",
    "release:check:prod": "node scripts/release-check.mjs",
    "release:check:no-rc": "node scripts/release-check.mjs --skip-revenuecat",
    "release:fix-hints": "node scripts/release-check.mjs --dry-run --skip-health --fix-hints",
    "data:freshness": "node scripts/check_data_freshness.js",
    "audit:membership": "node scripts/membership_integrity_audit.js",
    "committees:enrich": "node scripts/enrich_politician_committees_govtrack.js",
    "committees:import-csv": "node scripts/import_politician_committees_csv.js",
    "openinsider:import": "node scripts/openinsider_daily_import.js",
    "openinsider:backfill": "node scripts/openinsider_backfill_import.js",
    "openinsider:screener-months": "node scripts/openinsider_screener_month_import.js",
    "openinsider:convert-sd3v-csv": "node scripts/convert_sd3v_openinsider_csv.js",
    "capitol:sync": "node scripts/capitol_only_daily.js",
    "finnhub:csv-study": "node scripts/finnhub_csv_study.js",
    "finnhub:import-range": "node scripts/finnhub_range_import.js",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:smoke": "npm run build && playwright test e2e/smoke.spec.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.16.2",
    "@sendgrid/mail": "^8.1.6",
    "@types/node-fetch": "^2.6.13",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.0",
    "csv-parser": "^3.2.0",
    "jose": "^6.2.3",
    "next": "^15.5.18",
    "next-auth": "^4.24.7",
    "node-fetch": "^3.3.2",
    "react": "19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.1.0",
    "stripe": "^19.1.0",
    "yfinance": "^0.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.59.1",
    "playwright": "^1.48.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.18",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
