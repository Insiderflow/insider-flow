    "industry:seed": "node scripts/seed_industry_subsectors.js",
    "industry:backfill": "node scripts/backfill_issuer_subsectors.js",
    "finnhub:csv-study": "node scripts/finnhub_csv_study.js",
    "finnhub:import-range": "node scripts/finnhub_range_import.js",
    "finnhub:13f-import": "node scripts/finnhub_13f_import.js",
    "sec:13f-import": "node scripts/sec_13f_bulk_import.js",
