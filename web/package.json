    "chart.js": "^4.5.0",
    "csv-parser": "^3.2.0",
    "jose": "^6.2.3",
    "next": "^15.5.18",
    "next-auth": "^4.24.7",
    "node-fetch": "^3.3.2",
    "playwright": "^1.48.0",
    "react": "19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.1.0",
    "stripe": "^19.1.0",
    "yfinance": "^0.0.6"
