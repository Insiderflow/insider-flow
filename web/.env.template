# Google OAuth Credentials
GOOGLE_CLIENT_ID="replace_me"
GOOGLE_CLIENT_SECRET="replace_me"

# Facebook Login (optional — enables NextAuth + POST /api/mobile/auth/facebook). Same App ID as Meta developer console.
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""
# Optional: mobile Sign in with Google ID tokens may use iOS/Android OAuth client IDs as JWT audience — include those here if needed:
# GOOGLE_IOS_CLIENT_ID=""
# GOOGLE_ANDROID_CLIENT_ID=""
# Or comma-separated union override:
# GOOGLE_JWT_AUDIENCES="webclient.apps.googleusercontent.com,iosclient.apps.googleusercontent.com"

# NextAuth Configuration
NEXTAUTH_SECRET="replace_me"
# Must match the live site origin (same as NEXT_PUBLIC_BASE_URL), e.g. https://www.insiderflow.asia — not the apex unless you truly serve there.
NEXTAUTH_URL="https://your-domain.com"

# CORS: comma-separated origins allowed to call /api with credentials (browser). Include your deployed Vite/static URL when it’s not same-origin, e.g. https://app.example.com
# Defaults in code include localhost:5173 and https://www.insiderflow.asia; override in production if you add more.
CORS_ALLOWED_ORIGINS="https://www.insiderflow.asia,http://localhost:5173,http://localhost:4173"

