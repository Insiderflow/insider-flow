# RevenueCat (native subscriptions)
# Secret REST API key used by backend sync + webhook handlers.
REVENUECAT_SECRET_API_KEY="rc_secret_key_here"
# Shared bearer secret configured in RevenueCat webhook settings.
REVENUECAT_WEBHOOK_AUTH="replace-with-long-random-webhook-secret"
