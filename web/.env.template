DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"
SESSION_SECRET="replace-with-32-char-secret"
GRIDSEND_API_KEY="gs_replace_me"
EMAIL_FROM="no-reply@example.com"
# Public URL of this Next app (no trailing slash). Used in password-reset + verification email links. On Render, set to your service URL, e.g. https://insiderflow.onrender.com — must match the site users open, or links in email will 404 / wrong app.
NEXT_PUBLIC_BASE_URL="https://your-domain.com"
TRUST_PROXY=true

# Google OAuth Credentials
GOOGLE_CLIENT_ID="replace_me"
GOOGLE_CLIENT_SECRET="replace_me"

# NextAuth Configuration
NEXTAUTH_SECRET="replace_me"
NEXTAUTH_URL="https://your-domain.com"

# CORS: comma-separated origins allowed to call /api with credentials (browser). Include your deployed Vite/static URL when it’s not same-origin, e.g. https://app.example.com
# Defaults in code include localhost:5173 and https://www.insiderflow.asia; override in production if you add more.
CORS_ALLOWED_ORIGINS="https://www.insiderflow.asia,http://localhost:5173,http://localhost:4173"

# Background alerts sync (used by /api/alerts/sync)
ALERTS_SYNC_SECRET="replace-with-long-random-secret"
ADMIN_TOKEN="replace-with-long-random-admin-token"
INTERNAL_JOBS_SECRET="azsNrdo2arXJVYX9RINJViKbgNG7Xlt6cjmRv/vkrdmOMbcyK+IgLSub2AYIda3h"
MOBILE_AUTH_SECRET="replace-with-long-random-mobile-jwt-secret"

# RevenueCat (native subscriptions)
# Secret REST API key used by backend sync + webhook handlers.
REVENUECAT_SECRET_API_KEY="rc_secret_key_here"
# Shared bearer secret configured in RevenueCat webhook settings.
REVENUECAT_WEBHOOK_AUTH="replace-with-long-random-webhook-secret"
# Optional HMAC secret for validating x-revenuecat-signature (recommended when enabled in RC integration).
REVENUECAT_WEBHOOK_SECRET="replace-with-revenuecat-signature-secret"
# Optional: entitlement id used to decide active Pro status (if omitted, any active entitlement counts).
REVENUECAT_ENTITLEMENT_ID="pro"

# Subscription pipeline alerting (ops)
# Optional webhook endpoint to receive JSON alerts from internal subscription alert job.
SUBSCRIPTION_ALERT_WEBHOOK_URL="https://hooks.example.com/subscription-alerts"
# Optional threshold tuning.
SUBSCRIPTION_ALERT_COOLDOWN_MINUTES=30
SUBSCRIPTION_ALERT_DUE_NOW_WARN=25
SUBSCRIPTION_ALERT_DEAD_LETTER_RATE_CRITICAL=0.02
SUBSCRIPTION_ALERT_OLDEST_FAILED_MINUTES_WARN=30
SUBSCRIPTION_ALERT_STALE_PROCESSED_MINUTES_CRITICAL=120
