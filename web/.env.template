DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"
# Optional (Render / Neon): direct (non-pooler) URL for migrations only — see scripts/render-migrate-deploy.sh
# DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require"

# Optional: set to 1 to skip OpenInsider corporate scrape inside scripts/daily-scrape.js (does not affect Capitol Trades).
# OPENINSIDER_IMPORT_DISABLED=0
# Optional: curl --ipv4 when fetching OpenInsider (helps if IPv6 has no route to host).
# OPENINSIDER_CURL_IPV4=1
# Optional: delay ms between monthly screener requests (openinsider_screener_month_import.js).
# OPENINSIDER_SCREENER_SLEEP_MS=2500
# 主經紀商資金流: scrape OpenInsider 10% owner filings (istenpercent=1) + watchlist (Morgan Stanley, Goldman, …).
# One-off backfill: npm run openinsider:prime-brokers -- --days 180
# Daily import hook: set days > 0 to run after each openinsider:import
# OPENINSIDER_PRIME_BROKER_DAYS=0
# OPENINSIDER_PRIME_BROKER_MAX_PAGES=25
# OPENINSIDER_PRIME_BROKER_SLEEP_MS=700
# SEC Form 4 via edgartools (scripts/edgar_form4_export.py). Required by SEC; any valid email.
# EDGAR_IDENTITY="you@example.com"
# pip install -r requirements-edgar.txt
# npm run edgar:form4-backfill -- --days 90
# npm run edgar:form4-sync   # last 2 days → Neon (same as GitHub edgar-form4-sync.yml)
# GitHub Actions: secret EDGAR_IDENTITY (or SEC_IDENTITY) + DATABASE_URL
# npm run edgar:form4-backfill -- --from 2025-11-01 --to 2026-05-16
# sd3v OpenInsider overnight (cache + fetch missing months, import every 880 rows):
# pip install requests beautifulsoup4  # for scripts/sd3v_fetch_month.py
# npm run sd3v:overnight -- --from 2025-11 --to 2026-05
# tail -f /tmp/sd3v-overnight.log
SESSION_SECRET="replace-with-32-char-secret"
# Password reset emails (src/lib/email.ts → GridSend). Required in production unless DISABLE_EMAIL=true.
GRIDSEND_API_KEY="gs_replace_me"
EMAIL_FROM="team@insiderflow.asia"
# Public origin (no trailing slash). Use the same host users type (often www). Used for password-reset links and as fallback when NEXTAUTH_URL is unset.
NEXT_PUBLIC_BASE_URL="https://your-domain.com"
# Resend-verification emails (src/lib/emailService.ts → SendGrid). Separate from GridSend; both may be needed in prod.
# SENDGRID_API_KEY=""
# SENDGRID_FROM_EMAIL="team@insiderflow.asia"
TRUST_PROXY=true

# Optional: xAI (Grok) for mobile dashboard daily trade narrative (Traditional Chinese prompt when locale=zh-Hant).
# Without this key, a rules-based paragraph is generated from today's filings.
# XAI_API_KEY=""
# XAI_MODEL="grok-2-latest"
# DAILY_BRIEF_MAX_CALLS_PER_DAY=2

# SEC bulk 13F TSVs (free) — point at quarterly folders (e.g. IphoneAppUI/13F from sec.gov data sets).
# SEC_13F_DATA_DIR=../../IphoneAppUI/13F
# npm run sec:13f-import
# npm run sec:13f-import -- --all   # include rows without ticker match (symbol = CUSIP)

# Finnhub — 13F institutional holdings (institutional_holding_snapshots). Paid API tier required.
# FINNHUB_API_KEY=""
# npm run finnhub:13f-import -- --symbols-file data/13f_core_symbols.txt --quarters 6
# FINNHUB_13F_QUARTERS=6
# FINNHUB_13F_MAX_SYMBOLS=300
# FINNHUB_13F_SLEEP_MS=500

