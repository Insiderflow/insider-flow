DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"
SESSION_SECRET="replace-with-32-char-secret"
GRIDSEND_API_KEY="gs_replace_me"
EMAIL_FROM="no-reply@example.com"
# Public URL of this Next app (no trailing slash). Used in password-reset + verification email links. On Render, set to your service URL, e.g. https://insiderflow.onrender.com — must match the site users open, or links in email will 404 / wrong app.
NEXT_PUBLIC_BASE_URL="https://your-domain.com"
TRUST_PROXY=true

# Google OAuth Credentials
GOOGLE_CLIENT_ID="replace_me"
GOOGLE_CLIENT_SECRET="replace_me"

# NextAuth Configuration
NEXTAUTH_SECRET="replace_me"
NEXTAUTH_URL="https://your-domain.com"

# Background alerts sync (used by /api/alerts/sync)
ALERTS_SYNC_SECRET="replace-with-long-random-secret"
ADMIN_TOKEN="replace-with-long-random-admin-token"
MOBILE_AUTH_SECRET="replace-with-long-random-mobile-jwt-secret"
