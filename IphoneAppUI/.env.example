# Leave empty in dev to use Vite proxy → http://localhost:3000
# Production: https://www.insiderflow.asia
VITE_API_BASE_URL=

# Data mode for UI build-out:
#   snapshot — frozen JSON from `npm run snapshot` (real API captured once) [default]
#   live     — always hit API
#   mock     — hardcoded demo fixtures only
VITE_DATA_SOURCE=snapshot

# Legacy: same as VITE_DATA_SOURCE=mock when true
VITE_USE_MOCK=false

# mobile = Bearer tokens in localStorage; web = cookie session
VITE_AUTH_TRANSPORT=mobile

# Vite proxy target when running insider-flow/web locally (match `next dev` port)
VITE_DEV_API_PROXY=http://localhost:3000

# Snapshot script: API base if not on :3000 (auto-detects 3000–3003 by default)
# SNAPSHOT_API_BASE=http://localhost:3002

# Checkout uses API env (plan=monthly|yearly). For production mobile build:
# VITE_API_BASE_URL=https://www.insiderflow.asia

# GA4 (production default G-XNQRFHM8EV; omitted in dev unless set)
# VITE_GA_MEASUREMENT_ID=G-XNQRFHM8EV
